{
	"geode": "5.7.1",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "nwo5.ui-scaling",
	"name": "Editor UI Scaling",
	"version": "v1.0.2",
	"developer": "nwo5",
	"description": "*scales ur ui*",
	"tags": [
		"api", "utility", "editor", "customization", "interface", "offline"
	],
	"links": {
		"source": "https://github.com/Nwo5-trg/UI-Scaling",
		"community": "https://discord.gg/AeFeYWGUxZ"
	},
	"api": {
		"include": [
			"include/*.hpp"
		]
	},
	"dependencies": {
		"geode.node-ids": ">=v1.23.3",
		"nwo5.silly-api": ">=v1.10.4",
		"alphalaneous.editortab_api": "v2.1.11"
	},
	"settings": {
		"general-title": {
			"type": "title",
			"name": "General"
		},
		"settings-button-in-editor": {
			"type": "bool",
			"name": "Settings Button In Editor",
			"default": true,
			"description": "adds a settings button in editor pause"
		},
		"editor-ui-title": {
			"type": "title",
			"name": "Editor UI"
		},
		"editor-ui-enabled": {
			"type": "bool",
			"name": "Enabled",
			"default": true
		},
		"editor-ui-scaling": {
			"type": "float",
			"name": "Scaling",
			"default": 0.9,
			"min": 0.05,
			"max": 1,
			"enable-if": "editor-ui-enabled"
		},
		"editor-ui-vanilla-positioning": {
			"type": "bool",
			"name": "Vanilla Positioning",
			"default": false,
			"description": "by default this mod also fixes some inconsistencies in editor ui, this setting will revert that to be as consistent to the original as possible",
			"enable-if": "editor-ui-enabled"
		},
		"editor-ui-scale-toolbar": {
			"type": "bool",
			"name": "Scale Toolbar",
			"default": true,
			"enable-if": "editor-ui-enabled"
		},
		"editor-ui-center-slider": {
			"type": "bool",
			"name": "Center Slider",
			"default": false,
			"enable-if": "editor-ui-enabled && !editor-ui-vanilla-positioning"
		}
	}
}
